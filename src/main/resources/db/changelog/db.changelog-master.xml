<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1-create-product-table" author="demo-service">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="product"/>
            </not>
        </preConditions>
        <createTable tableName="product">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="description" type="VARCHAR(255)"/>
            <column name="price" type="DECIMAL(38, 2)"/>
            <column name="quantity" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2-insert-sample-product" author="demo-service">
        <insert tableName="product">
            <column name="name" value="Sample Product"/>
            <column name="description" value="A sample product"/>
            <column name="price" valueNumeric="19.99"/>
            <column name="quantity" valueNumeric="10"/>
        </insert>
    </changeSet>

    <changeSet id="3-create-users" author="demo-service">
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uk_users_email"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="failed_attempts" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="locked_until" type="TIMESTAMP"/>
        </createTable>

        <createIndex tableName="users"
                     indexName="idx_users_locked_until">
            <column name="locked_until"/>
        </createIndex>
    </changeSet>

    <changeSet id="4-create-permissions" author="demo-service">
        <createTable tableName="permissions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uk_permissions_name"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="5-create-user-permissions" author="demo-service">
        <createTable tableName="user_permissions">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="permission_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey
                tableName="user_permissions"
                columnNames="user_id, permission_id"
                constraintName="pk_user_permissions"/>
        <addForeignKeyConstraint
                baseTableName="user_permissions"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_user_permissions_user"
                onDelete="CASCADE"/>
        <addForeignKeyConstraint
                baseTableName="user_permissions"
                baseColumnNames="permission_id"
                referencedTableName="permissions"
                referencedColumnNames="id"
                constraintName="fk_user_permissions_permission"
                onDelete="CASCADE"/>
        <createIndex
                tableName="user_permissions"
                indexName="idx_user_permissions_permission">
            <column name="permission_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="6-create-test-users" author="demo-service">
        <insert tableName="users">
            <column name="email" value="user@example.com"/>
            <column name="password"
                    value="$2a$12$0rCyA50p03F3pPoL5BpwDu4Xtblebmfx301mIxARSHRklnPpaELFa"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="failed_attempts" valueNumeric="0"/>
        </insert>
        <insert tableName="users">
            <column name="email" value="admin@example.com"/>
            <column name="password"
                    value="$2a$12$0rCyA50p03F3pPoL5BpwDu4Xtblebmfx301mIxARSHRklnPpaELFa"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="failed_attempts" valueNumeric="0"/>
        </insert>
        <insert tableName="users">
            <column name="email" value="superadmin@example.com"/>
            <column name="password"
                    value="$2a$12$0rCyA50p03F3pPoL5BpwDu4Xtblebmfx301mIxARSHRklnPpaELFa"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="failed_attempts" valueNumeric="0"/>
        </insert>
    </changeSet>

    <changeSet id="7-create-test-permissions" author="demo-service">
        <sql>
            INSERT INTO permissions (name)
            SELECT 'VIEW_INFO' WHERE NOT EXISTS (
                SELECT 1 FROM permissions WHERE name = 'VIEW_INFO'
            );
        </sql>
        <sql>
            INSERT INTO permissions (name)
            SELECT 'VIEW_ADMIN' WHERE NOT EXISTS (
                SELECT 1 FROM permissions WHERE name = 'VIEW_ADMIN'
            );
        </sql>
        <sql>
            INSERT INTO user_permissions (user_id, permission_id)
            SELECT u.id, p.id
            FROM users u
                     CROSS JOIN permissions p
            WHERE u.email = 'user@example.com'
              AND p.name = 'VIEW_INFO'
              AND NOT EXISTS (SELECT 1
                              FROM user_permissions up
                              WHERE up.user_id = u.id
                                AND up.permission_id = p.id);
        </sql>
        <sql>
            INSERT INTO user_permissions (user_id, permission_id)
            SELECT u.id, p.id
            FROM users u
                     CROSS JOIN permissions p
            WHERE u.email = 'admin@example.com'
              AND p.name = 'VIEW_ADMIN'
              AND NOT EXISTS (SELECT 1
                              FROM user_permissions up
                              WHERE up.user_id = u.id
                                AND up.permission_id = p.id);
        </sql>
        <sql>
            INSERT INTO user_permissions (user_id, permission_id)
            SELECT u.id, p.id
            FROM users u
                     CROSS JOIN permissions p
            WHERE u.email = 'superadmin@example.com'
              AND p.name IN ('VIEW_INFO', 'VIEW_ADMIN')
              AND NOT EXISTS (SELECT 1
                              FROM user_permissions up
                              WHERE up.user_id = u.id
                                AND up.permission_id = p.id);
        </sql>
    </changeSet>

</databaseChangeLog>